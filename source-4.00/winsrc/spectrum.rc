STRINGTABLE 
{
 FatalNotImplemented, "This function is not yet implemented; please wait!"
 FatalDisplayNotSupp, "Sorry; this video adapter type not supported."
 FatalCreatePal, "Unable to create logical palette; booo."
 FatalMemAlloc, "Unable to allocate memory when I really needed it!"
 FatalNoRomfile, "Could not find ROMS.BIN file.  Put it in executable , Windows or current dir."
 LoadZ80Error, "Error reading .Z80 snapshot file"
 LoadZ80BadFile, ".Z80 file has bad format, or file corrupt"
 LoadZ80NoMem, "Error allocating memory while reading .Z80 file"
 LoadZ80UnkVer, "Unknown version; file corrupt or upgrade to new version needed."
 LoadZ80UnsupMode, "Hardware mode in .Z80 file not supported."
 EmulDiHalt, "Spectrum crashed through DI/HALT"
 FatalNoTimersLeft, "Could not allocate timer!  Close other applications and give it another shot."
 LogCantWrite, "Cannot write to log file."
 FatalNoSound, "Error opening Sound Device"
 TapCreateErr, "Error trying to create .TAP tape file"
 Fatal1, "Fatal Error, for Your Eyes Only, number 1"
 Fatal2, "Fatal Error, for Your Eyes Only, number 2"
 Fatal3, "Fatal Error, for Your Eyes Only, number 3"
 SaveZ80Error, "Error writing .Z80 snapshot file"
 SaveSampleError, "Error while trying to write to sample file"
 MemSampleError, "Unable to allocate memory for sample file buffer"
 SampleFileError, "Error trying to open sound sample file"
 SampleFileEnd, "Sample file played..."
 PrinterError, "Error trying to print ZX Printer output"
 BadTapFile, ".TAP file corrupted!  (maybe 'Warajevo' format?)"
 ErrReadingTap, "Error reading block from .TAP or .TZX file"
 SaveTapErr, "Error trying to append to .TAP file"
 ErrWritingMirTap, "Error trying to write mirrored .TAP block to temporary file"
 ErrAppMirTap, "Error appending mirrored .TAP block to current .TAP output file"
 InOpenError, "Error trying to open wave input device"
 LoadSNABadFile, ".SNA file is corrupt!  (should be 49178 bytes long)"
 LoadSNAError, "Error trying to open .SNA file"
 ErrorNoLayoutScr, "Could not find file ''layout.scr'', or file corrupt."
 fatalcurrahsamplerate, "Fatal error: currah emulation needs sample rate of 11025 or 22050 Hz"
 fatalcurrahfile, "Fatal error: Currah data file could not be read, or is corrupt"
 fatalmemory, "Fatal error: Currah emulation code could not allocate sufficient memory"
 FatalNoFilterString, "Fatal error: Could not get filter string resource during initialization"
 UnknownFileType, "Unknown extension - don't know what to do with it!"
 WontSaveSNA, "Error: You cannot save snapshots in .SNA format"
 NoWriteTZXFile, "Error: You cannot record .TZX tape files.  Use .TAP or sample file instead."
 WontSaveSLT, "Error: Snapshots are saved in .Z80 format.  .SLTs can be created using the ADDDAT utility"
 TZXFileEnd, "TZX file played..."
 TZXFileError, "Error playing TZX file.  Possible causes: file is corrupt, or disk error."
 MDRFileError, "Error reading microdrive file."
 MDRFileWriteError, "Error writing to microdrive file."
 MDRFileCreateError, "An error occured while I tried to create a microdrive cartridge file.  Wrong path or file name, or a full disk, are the most likely causes."
 CM_SOUND, "Error reading ROMS.BIN file; wrong version?"
 RSInErr, "Error while trying to read RS232 input file"
 RSOutErr, "Error while trying to write to RS232 output file"
 fatalWinGerr, "Error linking WinG library.  Most likely cause: WinG not (properly) installed. To disable fast WinG video, set \042UseWinG=0\042 in SPECTRUM.INI file."
 FatalUserSelMemAlloc, "Error: could not allocate memory for displaying TZX user selection menu.  Probable cause: TZX file corrupt."
 FatalVz80dError, "Unexpected failure of VZ80D driver.  Memory problem?  Try \042 VZ80D=0\042 in SPECTRUM.INI"
 LoadScreenError, "Error opening an .SCR screen file"
 SaveScreenError, "Error trying to open .SCR file for writing"
 LoadScreenError2, "Error loading screen; wrong format?"
 SaveScreenError2, "Error saving screen; wrong name or disk full?"
 SharewareMsg, "This feature is disabled in the shareware version.  See help file for registration details."
 SharewareTimeMsg, "This shareware program runs normally for ten minutes; now emulation speed is fixed at 500%.  The registered version is less annoying.  See Help for details."
 MsgUnknownLength, "Header of .Z80 (or .SLT) file contains extra fields.  I'm ignoring them, and hope for the best..."
 ErrorHardware, "Unknown (unsupported) hardware!  Snapshot file is probably intended for later version of WinZ80, or other emulator."
}
MAINMENU MENU 
{
 POPUP "File"
 {
  MENUITEM "&Open File...", CM_OPENFILE
  MENUITEM SEPARATOR
  MENUITEM "&Load snapshot...\a(F3)", CM_LOADSNAP
  MENUITEM "&Play tape file\a(F7)", CM_PLAYTAP
  MENUITEM "Load screen\a(alt F3)", CM_LOADSCREEN
  MENUITEM "Play sa&mple file", CM_PLAYSAMPLE
  MENUITEM "Load &default settings", CM_LOADDEFAULT
  MENUITEM SEPARATOR
  MENUITEM "&Save snapshot...\a(F2)", CM_SAVESNAP
  MENUITEM "Record &tape file\a(alt F7)", CM_RECTAP
  MENUITEM "Save screen/movie\a(alt F2)", CM_SAVESCREEN
  MENUITEM "&Record sounds...", CM_RECORD
  MENUITEM "Save default s&ettings", CM_SAVEDEFAULTS
  MENUITEM SEPARATOR
  MENUITEM "Select alternate R&OM files...", CM_ALTROMS
  MENUITEM SEPARATOR
  MENUITEM "Send &Form Feed", CM_FORMFEED
  MENUITEM "Show &keyboard layout\a (alt F1)", CM_HELPSCREEN
  MENUITEM SEPARATOR
  MENUITEM "&About", CM_INFO
  MENUITEM "&Quit", CM_QUIT
 }

 POPUP "Settings"
 {
  MENUITEM "&Hardware...\a(F9)", CM_HARDWARE
  MENUITEM "&Speed...\a(F4)", CM_SPEED
  POPUP "&Joystick"
  {
   MENUITEM "&Define keys...", CM_DEFKEYS
   MENUITEM SEPARATOR
   MENUITEM "&Cursor joystick", CM_CURSOR
   MENUITEM "&Kempston joystick", CM_KEMPSTON
   MENUITEM "&Sinclair joystick", CM_SINCLAIR
   MENUITEM "&User defined joystick", CM_USERDEFJOY
  }

  MENUITEM "&Microdrive...\a(F8)", CM_MDRV
  MENUITEM "&Rs232 I/O...", CM_RS
  MENUITEM "Sound outpu&t", CM_SO
  MENUITEM SEPARATOR
  MENUITEM "S&ound", CM_SOUND
  MENUITEM "&Fixed-pitch sound", CM_PITCH
  MENUITEM "&Coppering", CM_COPPERING
  MENUITEM "&Large border", CM_LARGEBORDER
  MENUITEM "&Emulate ZX Printer", CM_ZXPRINTER
  MENUITEM "Issue-&2", CM_ISSUE2
  MENUITEM "&128k Shifted cursor keys", CM_128SHIFT
  MENUITEM "&Intelli-in", CM_INTELLIIN
 }

 MENUITEM "Control..", CM_CONTROL
 MENUITEM "Debug..", CM_DEBUG
 MENUITEM "?", CM_HELP
}
LOADZ80FILE DIALOG 93, 17, 144, 219
STYLE DS_LOCALEDIT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Load snapshot file"
FONT 8, "MS Sans Serif"
{
 EDITTEXT LZF_EDIT, 6, 19, 133, 13, ES_AUTOHSCROLL | ES_NOHIDESEL | WS_BORDER | WS_TABSTOP
 DEFPUSHBUTTON "OK", LZF_OK, 88, 194, 50, 14
 LTEXT "", LZF_DIRECTORY, 7, 8, 130, 8
 LISTBOX LZF_LISTBOX, 8, 39, 74, 171, LBS_STANDARD | LBS_WANTKEYBOARDINPUT
 PUSHBUTTON "Cancel", LZF_CANCEL, 88, 172, 50, 14
 PUSHBUTTON "(delete)", LZF_DELETE, 88, 40, 50, 14
 CONTROL ".VOC files", LZF_VOC, "BUTTON", BS_AUTORADIOBUTTON, 88, 119, 52, 12
 CONTROL ".WAV files", LZF_WAV, "BUTTON", BS_AUTORADIOBUTTON, 88, 132, 52, 12
 CONTROL "Raw samples", LZF_RAW, "BUTTON", BS_AUTORADIOBUTTON, 88, 146, 56, 12
}



DIHALTDIALOG DIALOG 75, 57, 194, 59
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_DLGFRAME | WS_SYSMENU
FONT 8, "MS Sans Serif"
{
 PUSHBUTTON "Continue", DIH_CONT, 12, 36, 50, 14
 DEFPUSHBUTTON "EI && Continue", DIH_EICONT, 72, 36, 50, 14
 PUSHBUTTON "Pause", DIH_PAUSE, 132, 36, 50, 14
 CTEXT "Spectrum crashed by DI/HALT; choose:", -1, 42, 12, 142, 11
 ICON "z80icon", -1, 17, 11, 14, 16
}



SPEEDDIALOG DIALOG 74, 19, 96, 138
STYLE DS_LOCALEDIT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Emulation speed"
FONT 8, "MS Sans Serif"
{
 PUSHBUTTON "Close", SPD_CLOSE, 3, 120, 50, 15
 CHECKBOX "Maximum", SPD_MAX, 4, 5, 60, 12, BS_AUTOCHECKBOX | WS_TABSTOP
 LTEXT "Set speed:", SPD_SETSPEED, 4, 26, 68, 10
 LTEXT "Actual speed:", SPD_ACTSPEED, 4, 37, 69, 10
 GROUPBOX "Video setting:", 105, 4, 56, 63, 57, BS_GROUPBOX
 SCROLLBAR SPD_KNOB, 78, 6, 11, 128, SBS_VERT
 RADIOBUTTON "Fast, chunky", SPD_CHUNCKY, 7, 73, 58, 12
 RADIOBUTTON "Normal", SPD_NORMAL, 7, 86, 58, 12
 RADIOBUTTON "Smooth", SPD_SMOOTH, 7, 99, 58, 12
}
FileExists DIALOG 28, 48, 194, 57
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "File Exists!"
FONT 8, "MS Sans Serif"
{
 DEFPUSHBUTTON "Overwrite", FE_OVERWRITE, 12, 38, 50, 14
 PUSHBUTTON "Append", FE_APPEND, 72, 39, 50, 14
 DEFPUSHBUTTON "Cancel", FE_CANCEL, 132, 39, 50, 14
 CTEXT "Text", FILE_TEXT, 12, 9, 174, 22
}

FileExists2 DIALOG 28, 48, 175, 57
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "File Exists!"
FONT 8, "MS Sans Serif"
{
 DEFPUSHBUTTON "Overwrite", FE_OVERWRITE, 12, 38, 50, 14
 DEFPUSHBUTTON "Cancel", FE_CANCEL, 112, 39, 50, 14
 CTEXT "Text", FILE_TEXT, 12, 9, 156, 22
}


RECORD DIALOG 40, 75, 190, 72
STYLE DS_LOCALEDIT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "Record sound in sample file"
FONT 8, "MS Sans Serif"
{
 PUSHBUTTON "Cancel", REC_STOP, 135, 53, 50, 14
 CONTROL "File name: <none>", REC_FILENAME, "STATIC", SS_LEFTNOWORDWRAP | WS_CHILD | WS_VISIBLE | WS_GROUP, 8, 9, 192, 8
 CONTROL "", -1, "static", SS_BLACKFRAME | WS_CHILD | WS_VISIBLE, 3, 6, 183, 15
 LTEXT "Time recorded: 0:00", REC_TIME, 4, 28, 180, 8
 PUSHBUTTON "Open file", REC_OPENFILE, 4, 53, 50, 14
 LTEXT "Sample rate (Hz):", -1, 4, 40, 60, 8
 CONTROL "22050", REC_SRATEEDIT, "EDIT", WS_BORDER | WS_TABSTOP, 64, 38, 42, 12
 LTEXT "22050", REC_SRATE, 66, 40, 39, 8
}



CONTROLDIALOG DIALOG -51, 90, 51, 96
STYLE DS_LOCALEDIT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Control"
FONT 8, "MS Sans Serif"
{
 PUSHBUTTON "NMI", CTRL_NMI, 3, 62, 45, 14, NOT WS_TABSTOP
 PUSHBUTTON "Reset", CTRL_RESET, 3, 79, 45, 14, NOT WS_TABSTOP
 PUSHBUTTON "Load", CTRL_LOAD, 3, 26, 45, 14, NOT WS_TABSTOP
 PUSHBUTTON "Save", CTRL_SAVE, 3, 44, 45, 14, NOT WS_TABSTOP
 PUSHBUTTON "Pause", CTRL_PAUSE, 3, 8, 46, 14
}

JOYDIALOG DIALOG 30, 20, 132, 100
STYLE DS_LOCALEDIT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Define joystick keys"
FONT 8, "MS Sans Serif"
{
 LTEXT "Left:", JOY_LEFT, 11, 26, 25, 8
