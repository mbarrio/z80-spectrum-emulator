; Contains routines for VGA graphics mode (mode 0x13)

init_vga2:
        push ds
        push es
        push cs
        push cs
        pop ds
        pop es

        call get_numscanlines
        mov byte cs:gmod,6              ;vga2
        call prvk
        mov ax,013
        int 010                         ;select mode
        cmp byte cs:greyvga,0ff
        jnz keep_blue2
        mov cs:b[offset vga_palette+3],25
        mov cs:b[offset vga_palette+27],25
keep_blue2:
        xor bx,bx                       ;offset
        mov cx,16                       ;16 regs
        mov dx,offset vga_palette
        mov ax,01012                    ;set blk of DAC registers
        int 010
        cmp byte cs:greyvga,0ff
        jnz geen_robkleuren2
        mov ax,0101b
        xor bx,bx
        mov cx,16
        int 010
geen_robkleuren2:
        call init_vgaworkspace
        mov ax,0a000
        mov es,ax
        cld
        mov di,0
        mov cx,64000/2
        mov ax,0808
        rep stosw
        pop es
        pop ds
        ret


;see vgaborder_update in video.8.  Clears border; also used in hcr mode.

vgaborder_upd_2:
        push es
        push di
        mov ax,0a000
        mov es,ax
        xor di,di
        mov cx,160*4+16
        cmp byte cs:_vocplay,0
        jne vga_b_black         ;during tzx/voc playback, only overscan
        mov al,cs:newbor
        and al,7
vga_b_black:
        mov ah,al
        cld
        rep stosw
        mov cx,192
restore_brder2:
        add di,256
        push cx
        mov cx,32
        rep stosw
        pop cx
        loop restore_brder2
        mov cx,160*4-16
        rep stosw
        pop di
        pop es
        ret

